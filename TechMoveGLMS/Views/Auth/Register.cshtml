@model TechMoveGLMS.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — TechMove GLMS</title>

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <style>
        :root {
            --ink: #0A0E1A;
            --surface: #0D1220;
            --panel: #161D2E;
            --border: rgba(255,255,255,0.07);
            --border-hi: rgba(99,210,190,0.40);
            --teal: #63D2BE;
            --teal-light: #85E5D2;
            --green: #5ADB8E;
            --amber: #F4A535;
            --red: #F05A5A;
            --text: #F0F4FF;
            --muted: #6B7894;
            --subtle: #3A4460;
            --font-d: 'Syne', sans-serif;
            --font-m: 'DM Mono', monospace;
            --font-b: 'Inter', sans-serif;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            background: var(--ink);
            color: var(--text);
            font-family: var(--font-b);
            -webkit-font-smoothing: antialiased;
        }

        .rp-page {
            min-height: 100vh;
            display: flex;
        }

        /* LEFT PANEL */
        .rp-left {
            width: 42%;
            background: var(--surface);
            border-right: 1px solid var(--border);
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

            .rp-left::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(circle, rgba(99,210,190,0.05) 1px, transparent 1px);
                background-size: 26px 26px;
                pointer-events: none;
            }

            .rp-left::after {
                content: '';
                position: absolute;
                top: -80px;
                right: -80px;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(99,210,190,0.05) 0%, transparent 70%);
                pointer-events: none;
            }

        .rp-brand {
            position: relative;
            z-index: 1;
        }

        .rp-logo-mark {
            width: 42px;
            height: 42px;
            background: var(--teal);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-d);
            font-weight: 800;
            font-size: 13px;
            color: var(--ink);
            margin-bottom: 0.85rem;
        }

        .rp-brand-name {
            font-family: var(--font-d);
            font-weight: 800;
            font-size: 1.3rem;
            letter-spacing: -0.04em;
            color: var(--text);
        }

        .rp-brand-sub {
            font-family: var(--font-m);
            font-size: 0.6rem;
            color: var(--teal);
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-top: 4px;
        }

        .rp-body {
            position: relative;
            z-index: 1;
        }

        .rp-headline {
            font-family: var(--font-d);
            font-size: 1.9rem;
            font-weight: 800;
            letter-spacing: -0.05em;
            line-height: 1.1;
            color: var(--text);
            margin-bottom: 0.85rem;
        }

            .rp-headline span {
                color: var(--teal);
            }

        .rp-desc {
            font-size: 0.8rem;
            color: var(--muted);
            line-height: 1.75;
            max-width: 240px;
            margin-bottom: 1.75rem;
        }

        .rp-perks {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .rp-perk {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.76rem;
            color: var(--muted);
        }

        .perk-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--teal);
            flex-shrink: 0;
        }

        .rp-footer {
            position: relative;
            z-index: 1;
            font-family: var(--font-m);
            font-size: 0.58rem;
            color: var(--subtle);
            letter-spacing: 0.06em;
        }

        /* RIGHT PANEL */
        .rp-right {
            width: 58%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            overflow-y: auto;
        }

        .rp-form-wrap {
            width: 100%;
            max-width: 420px;
        }

        .rp-form-title {
            font-family: var(--font-d);
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            color: var(--text);
            margin-bottom: 3px;
        }

        .rp-form-sub {
            font-size: 0.78rem;
            color: var(--muted);
            margin-bottom: 1.75rem;
        }

        .rp-alert-error {
            background: rgba(240,90,90,0.08);
            border: 1px solid rgba(240,90,90,0.2);
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 0.76rem;
            color: var(--red);
            margin-bottom: 1.5rem;
        }

        .rp-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.85rem;
        }

        .rp-field {
            margin-bottom: 1rem;
        }

        .rp-label {
            display: block;
            font-family: var(--font-m);
            font-size: 0.6rem;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .rp-optional {
            font-size: 0.55rem;
            color: var(--subtle);
            margin-left: 5px;
            letter-spacing: 0.04em;
        }

        .rp-input-wrap {
            display: flex;
            align-items: center;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
            transition: border-color 0.2s;
        }

            .rp-input-wrap:focus-within {
                border-color: var(--border-hi);
            }

        .rp-input-icon {
            width: 42px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--subtle);
            font-size: 14px;
            transition: color 0.2s;
        }

        .rp-input-wrap:focus-within .rp-input-icon {
            color: var(--teal);
        }

        .rp-input-wrap input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text);
            font-family: var(--font-b);
            font-size: 0.83rem;
            padding: 0.68rem 0.7rem 0.68rem 0;
        }

            .rp-input-wrap input::placeholder {
                color: var(--subtle);
            }

        .rp-eye-btn {
            width: 40px;
            flex-shrink: 0;
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--subtle);
            transition: color 0.2s;
            padding: 0;
        }

            .rp-eye-btn:hover {
                color: var(--teal);
            }

        .strength-wrap {
            display: flex;
            gap: 3px;
            align-items: center;
            margin-top: 6px;
        }

        .strength-bar {
            flex: 1;
            height: 3px;
            border-radius: 2px;
            background: var(--subtle);
            transition: background 0.3s;
        }

        .strength-label {
            font-family: var(--font-m);
            font-size: 0.6rem;
            min-width: 38px;
            text-align: right;
            color: var(--subtle);
        }

        .rp-val-error {
            font-size: 0.7rem;
            color: var(--red);
            margin-top: 4px;
            display: block;
        }

        .rp-btn-submit {
            width: 100%;
            padding: 0.8rem;
            background: var(--teal);
            border: none;
            border-radius: 10px;
            font-family: var(--font-d);
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--ink);
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 1.25rem;
        }

            .rp-btn-submit:hover {
                background: var(--teal-light);
                transform: translateY(-1px);
            }

            .rp-btn-submit:active {
                transform: translateY(0);
            }

        .rp-divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 1.1rem 0 0.85rem;
        }

        .rp-div-line {
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .rp-div-text {
            font-family: var(--font-m);
            font-size: 0.6rem;
            color: var(--subtle);
            letter-spacing: 0.1em;
            white-space: nowrap;
        }

        .rp-login-row {
            text-align: center;
            font-size: 0.75rem;
            color: var(--muted);
        }

            .rp-login-row a {
                color: var(--teal);
                text-decoration: none;
                font-weight: 500;
            }

                .rp-login-row a:hover {
                    color: var(--teal-light);
                }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .rp-left {
                display: none;
            }

            .rp-right {
                width: 100%;
            }

            .rp-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="rp-page">

        <!-- LEFT PANEL -->
        <div class="rp-left">
            <div class="rp-brand">
                <div class="rp-logo-mark">TM</div>
                <div class="rp-brand-name">TechMove GLMS</div>
                <div class="rp-brand-sub">Global Logistics Management</div>
            </div>

            <div class="rp-body">
                <h1 class="rp-headline">Join the<br><span>operations team.</span></h1>
                <p class="rp-desc">Get full access to contracts, clients, and service request management across the TechMove platform.</p>
                <div class="rp-perks">
                    <div class="rp-perk"><div class="perk-dot"></div>Real-time contract tracking</div>
                    <div class="rp-perk"><div class="perk-dot"></div>Live USD/ZAR exchange rates</div>
                    <div class="rp-perk"><div class="perk-dot"></div>Service request management</div>
                    <div class="rp-perk"><div class="perk-dot"></div>Full analytics dashboard</div>
                </div>
            </div>

            <div class="rp-footer">© @DateTime.Now.Year TechMove GLMS · All rights reserved</div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="rp-right">
            <div class="rp-form-wrap">
                <h2 class="rp-form-title">Create account</h2>
                <p class="rp-form-sub">Fill in your details to get started</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
                {
                    <div class="rp-alert-error">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            foreach (var error in modelState.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        }
                    </div>
                }

                <form asp-action="Register" method="post">

                    <div class="rp-row">
                        <div class="rp-field">
                            <label asp-for="FullName" class="rp-label">Full Name</label>
                            <div class="rp-input-wrap">
                                <div class="rp-input-icon">
                                    <i class="fas fa-user"></i>
                                </div>
                                <input asp-for="FullName" type="text" placeholder="Your full name" />
                            </div>
                            <span asp-validation-for="FullName" class="rp-val-error"></span>
                        </div>
                        <div class="rp-field">
                            <label asp-for="Username" class="rp-label">Username</label>
                            <div class="rp-input-wrap">
                                <div class="rp-input-icon">
                                    <i class="fas fa-at"></i>
                                </div>
                                <input asp-for="Username" type="text" placeholder="Choose username" />
                            </div>
                            <span asp-validation-for="Username" class="rp-val-error"></span>
                        </div>
                    </div>

                    <div class="rp-field">
                        <label asp-for="Email" class="rp-label">Email <span class="rp-optional">optional</span></label>
                        <div class="rp-input-wrap">
                            <div class="rp-input-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <input asp-for="Email" type="email" placeholder="your@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="rp-val-error"></span>
                    </div>

                    <div class="rp-field">
                        <label asp-for="Password" class="rp-label">Password</label>
                        <div class="rp-input-wrap">
                            <div class="rp-input-icon">
                                <i class="fas fa-lock"></i>
                            </div>
                            <input asp-for="Password" type="password" id="pwInput" placeholder="Create a password" />
                            <button type="button" class="rp-eye-btn" id="pwToggle">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <div class="strength-wrap">
                            <div class="strength-bar" id="sb1"></div>
                            <div class="strength-bar" id="sb2"></div>
                            <div class="strength-bar" id="sb3"></div>
                            <div class="strength-bar" id="sb4"></div>
                            <span class="strength-label" id="sbLbl">—</span>
                        </div>
                        <span asp-validation-for="Password" class="rp-val-error"></span>
                    </div>

                    <div class="rp-field">
                        <label asp-for="ConfirmPassword" class="rp-label">Confirm Password</label>
                        <div class="rp-input-wrap">
                            <div class="rp-input-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <input asp-for="ConfirmPassword" type="password" id="cpInput" placeholder="Repeat your password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="rp-val-error"></span>
                    </div>

                    <button type="submit" class="rp-btn-submit">
                        <i class="fas fa-user-plus"></i>
                        Create account
                    </button>

                    <div class="rp-divider">
                        <div class="rp-div-line"></div>
                        <span class="rp-div-text">Already a member?</span>
                        <div class="rp-div-line"></div>
                    </div>
                    <div class="rp-login-row">
                        <a asp-action="Login">Sign in instead →</a>
                    </div>
                </form>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Password visibility toggle
        (function() {
            var btn = document.getElementById('pwToggle');
            var inp = document.getElementById('pwInput');
            var eyeIcon = document.getElementById('eyeIcon');
            var shown = false;
            if (!btn || !inp) return;
            btn.addEventListener('click', function() {
                shown = !shown;
                inp.type = shown ? 'text' : 'password';
                if (eyeIcon) {
                    eyeIcon.className = shown ? 'fas fa-eye-slash' : 'fas fa-eye';
                }
            });
        })();

        // Password strength meter
        var pwInput = document.getElementById('pwInput');
        if (pwInput) {
            pwInput.addEventListener('input', function() {
                var v = this.value;
                var bars = ['sb1','sb2','sb3','sb4'].map(function(id) { return document.getElementById(id); });
                var lbl = document.getElementById('sbLbl');
                bars.forEach(function(b) { if (b) b.style.background = '#3A4460'; });
                if (!v) {
                    if (lbl) { lbl.textContent = '—'; lbl.style.color = '#3A4460'; }
                    return;
                }
                var score = 0;
                if (v.length >= 8) score++;
                if (/[A-Z]/.test(v)) score++;
                if (/[0-9]/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;
                var labels = ['Weak', 'Fair', 'Good', 'Strong'];
                var colors = ['#F05A5A', '#F4A535', '#63D2BE', '#5ADB8E'];
                for (var i = 0; i < score; i++) {
                    if (bars[i]) bars[i].style.background = colors[score - 1];
                }
                if (lbl) {
                    lbl.textContent = labels[score - 1] || '—';
                    lbl.style.color = colors[score - 1] || '#3A4460';
                }
            });
        }
    </script>
</body>
</html>