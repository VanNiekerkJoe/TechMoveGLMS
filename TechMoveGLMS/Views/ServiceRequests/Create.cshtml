@model TechMoveGLMS.Models.ServiceRequest

@{
    ViewData["Title"] = "New Service Request";
    var exchangeRate = ViewBag.ExchangeRate ?? 19.00m;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
{
    <div class="alert alert-danger alert-dismissible fade show">
        <strong>Please correct the following errors:</strong>
        <ul class="mb-0 mt-2">
            @foreach (var ms in ViewData.ModelState.Values)
                foreach (var err in ms.Errors)
                {
                    <li>@err.ErrorMessage</li>
                }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div style="max-width: 620px; margin: 0 auto;">
    <div style="margin-bottom: 1.5rem;">
        <span class="tm-section-label">Service Requests / New</span>
        <h1 style="font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; letter-spacing: -0.04em; margin: 0;">
            Submit Request
        </h1>
    </div>

    <div class="card">
        <div class="card-header" style="display: flex; align-items: center; justify-content: space-between;">
            <span><i class="fas fa-headset me-2" style="color: var(--tm-teal);"></i>Service Request</span>
            <span style="font-family: var(--font-mono); font-size: 0.65rem; padding: 3px 10px; border-radius: 6px; background: rgba(99,210,190,0.1); color: var(--tm-teal);">
                <i class="fas fa-exchange-alt me-1"></i>1 USD = @exchangeRate.ToString("N4") ZAR
            </span>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" id="serviceRequestForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-4">
                    <label asp-for="ContractId" class="form-label">Contract</label>
                    <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId">
                        <option value="">— Select a contract —</option>
                    </select>
                    <span asp-validation-for="ContractId" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the service request..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CostUSD" class="form-label">Amount (USD)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="CostUSD" id="CostUSD" class="form-control" step="0.01" placeholder="0.00" value="0" />
                    </div>
                    <span asp-validation-for="CostUSD" class="text-danger"></span>
                </div>

                <input type="hidden" name="CostZAR" id="CostZAR" value="0" />

                <div class="mb-4">
                    <label class="form-label">Estimated ZAR</label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input id="estimatedZAR" class="form-control bg-light" readonly placeholder="Auto-calculated" />
                    </div>
                    <div style="margin-top: 5px; font-family: var(--font-mono); font-size: 0.63rem; color: var(--tm-muted);">
                        Live rate: 1 USD = @exchangeRate.ToString("N4") ZAR
                    </div>
                </div>

                <hr style="border-color: var(--tm-border); margin: 1.5rem 0;" />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="tm-btn-ghost">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="tm-btn-primary">
                        <i class="fas fa-save"></i> Create Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        var exchangeRate = parseFloat('@exchangeRate.ToString().Replace(",", ".")');
        var usdInput = document.getElementById('CostUSD');
        var zarHidden = document.getElementById('CostZAR');
        var estimatedZar = document.getElementById('estimatedZAR');

        function updateZAR() {
            var usd = parseFloat(usdInput.value) || 0;
            var zar = (usd * exchangeRate).toFixed(2);
            estimatedZar.value = zar;
            zarHidden.value = zar;
        }

        if (usdInput) {
            usdInput.addEventListener('input', updateZAR);
            usdInput.addEventListener('change', updateZAR);
        }
        updateZAR();
    </script>
}
