@{
    ViewData["Title"] = "Dashboard";
    var currentDate = DateTime.Now;
    var greeting = currentDate.Hour < 12 ? "Good Morning" : currentDate.Hour < 18 ? "Good Afternoon" : "Good Evening";
    var greetingEmoji = currentDate.Hour < 12 ? "☀" : currentDate.Hour < 18 ? "⚡" : "🌙";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<!-- ─── GREETING ─── -->
<div class="tm-greeting">
    <div>
        <div class="tm-greeting-label">TechMove Operations Center</div>
        <div class="tm-greeting-title">@greeting, TechMove Team @greetingEmoji</div>
        <div class="tm-greeting-sub">
            @currentDate.ToString("dddd, MMMM dd, yyyy")
            &nbsp;·&nbsp;
            <span class="tm-pulse"></span>
            <span style="color: var(--tm-green);">All systems operational</span>
        </div>
    </div>
    <div class="tm-greeting-actions">
        <a href="/Contracts/Create" class="tm-btn-ghost">
            <i class="fas fa-file-signature"></i> New Contract
        </a>
        <a href="/ServiceRequests/Create" class="tm-btn-primary">
            <i class="fas fa-plus"></i> New Request
        </a>
    </div>
</div>

<!-- ─── STAT CARDS ─── -->
<div class="tm-stat-grid">
    <div class="tm-stat-card" onclick="location.href='/Clients'">
        <div class="tm-stat-trend tm-trend-up" id="clientTrend">—</div>
        <div class="tm-stat-icon tm-si-teal"><i class="fas fa-users"></i></div>
        <div class="tm-stat-num" id="totalClients">–</div>
        <div class="tm-stat-lbl">Total Clients</div>
    </div>
    <div class="tm-stat-card" onclick="location.href='/Contracts'">
        <div class="tm-stat-trend tm-trend-up">+12%</div>
        <div class="tm-stat-icon tm-si-amber"><i class="fas fa-file-contract"></i></div>
        <div class="tm-stat-num" id="totalContracts">–</div>
        <div class="tm-stat-lbl">Total Contracts</div>
    </div>
    <div class="tm-stat-card" onclick="location.href='/ServiceRequests'">
        <div class="tm-stat-trend tm-trend-down">-3%</div>
        <div class="tm-stat-icon tm-si-red"><i class="fas fa-headset"></i></div>
        <div class="tm-stat-num" id="totalRequests">–</div>
        <div class="tm-stat-lbl">Service Requests</div>
    </div>
    <div class="tm-stat-card" onclick="location.href='/Contracts'">
        <div class="tm-stat-trend tm-trend-up">+5%</div>
        <div class="tm-stat-icon tm-si-green"><i class="fas fa-chart-line"></i></div>
        <div class="tm-stat-num" id="activeContracts">–</div>
        <div class="tm-stat-lbl">Active Contracts</div>
    </div>
</div>

<!-- ─── CHARTS ROW ─── -->
<div class="tm-charts-row">
    <div class="tm-panel">
        <div class="tm-panel-hd">
            <span class="tm-panel-title"><i class="fas fa-chart-line me-2" style="color:var(--tm-teal)"></i>Contract Activity</span>
            <span class="tm-panel-tag">MONTHLY OVERVIEW</span>
        </div>
        <div class="tm-panel-body">
            <div class="tm-chart-wrap">
                <canvas id="contractChart"></canvas>
            </div>
        </div>
    </div>

    <div class="tm-panel">
        <div class="tm-panel-hd">
            <span class="tm-panel-title"><i class="fas fa-chart-pie me-2" style="color:var(--tm-amber)"></i>Status Split</span>
            <span class="tm-panel-tag">LIVE</span>
        </div>
        <div class="tm-panel-body" style="padding: 1rem 1.5rem;">
            <canvas id="statusChart" style="max-height: 200px;"></canvas>
            <div id="statusLegend" style="margin-top: 0.75rem;"></div>
        </div>
    </div>
</div>

<!-- ─── BOTTOM ROW ─── -->
<div class="tm-bottom-row">
    <div class="tm-panel">
        <div class="tm-panel-hd">
            <span class="tm-panel-title"><i class="fas fa-clock me-2" style="color:var(--tm-teal)"></i>Recent Requests</span>
            <a href="/ServiceRequests" class="tm-panel-link">View all →</a>
        </div>
        <ul class="tm-req-list" id="recentRequests">
            <li style="padding: 2rem; text-align: center; color: var(--tm-muted); font-family: var(--font-mono); font-size: 0.75rem;">
                Loading...
            </li>
        </ul>
    </div>

    <div class="tm-panel">
        <div class="tm-panel-hd">
            <span class="tm-panel-title"><i class="fas fa-bolt me-2" style="color:var(--tm-amber)"></i>Quick Actions</span>
        </div>
        <div class="tm-qa-list">
            <a href="/Clients/Create" class="tm-qa-btn">
                <div class="tm-qa-icon"><i class="fas fa-user-plus"></i></div>
                <div>
                    <div class="tm-qa-title">Add New Client</div>
                    <div class="tm-qa-sub">Register a client profile</div>
                </div>
                <span class="tm-qa-arrow">→</span>
            </a>
            <a href="/Contracts/Create" class="tm-qa-btn">
                <div class="tm-qa-icon"><i class="fas fa-file-signature"></i></div>
                <div>
                    <div class="tm-qa-title">Create Contract</div>
                    <div class="tm-qa-sub">Attach PDF & set terms</div>
                </div>
                <span class="tm-qa-arrow">→</span>
            </a>
            <a href="/ServiceRequests/Create" class="tm-qa-btn">
                <div class="tm-qa-icon"><i class="fas fa-headset"></i></div>
                <div>
                    <div class="tm-qa-title">Submit Service Request</div>
                    <div class="tm-qa-sub">Log a new support ticket</div>
                </div>
                <span class="tm-qa-arrow">→</span>
            </a>
            <a href="#" class="tm-qa-btn" style="border-color: rgba(99,210,190,0.2); background: rgba(99,210,190,0.03);">
                <div class="tm-qa-icon" style="background: rgba(99,210,190,0.15);"><i class="fas fa-download"></i></div>
                <div>
                    <div class="tm-qa-title">Export Analytics</div>
                    <div class="tm-qa-sub">Download full report PDF</div>
                </div>
                <span class="tm-qa-arrow" style="color: var(--tm-teal);">→</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let contractChart, statusChart;

        function animateCount(el, target, duration) {
            var start = 0, startTime = null;
            el.textContent = '0';
            function step(ts) {
                if (!startTime) startTime = ts;
                var progress = Math.min((ts - startTime) / duration, 1);
                var eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.floor(eased * target);
                if (progress < 1) requestAnimationFrame(step);
                else el.textContent = target;
            }
            requestAnimationFrame(step);
        }

        $(document).ready(function () {
            loadStats();
            loadRecent();
        });

        function loadStats() {
            $.get('/api/dashboard/stats', function (data) {
                animateCount(document.getElementById('totalClients'), data.totalClients, 1200);
                animateCount(document.getElementById('totalContracts'), data.totalContracts, 1400);
                animateCount(document.getElementById('totalRequests'), data.totalRequests, 1100);
                animateCount(document.getElementById('activeContracts'), data.activeContracts, 1300);

                if (contractChart) contractChart.destroy();
                if (statusChart) statusChart.destroy();

                Chart.defaults.color = '#6B7894';
                Chart.defaults.font.family = "'DM Mono', monospace";
                Chart.defaults.font.size = 10;

                contractChart = new Chart(document.getElementById('contractChart'), {
                    type: 'line',
                    data: {
                        labels: data.monthlyContracts.labels,
                        datasets: [{
                            label: 'Contracts',
                            data: data.monthlyContracts.values,
                            borderColor: '#63D2BE',
                            backgroundColor: 'rgba(99,210,190,0.08)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#63D2BE',
                            pointBorderColor: '#1C2540',
                            pointBorderWidth: 2,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#161D2E',
                                borderColor: 'rgba(99,210,190,0.3)',
                                borderWidth: 1,
                                titleColor: '#63D2BE',
                                bodyColor: '#F0F4FF',
                                padding: 10
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                                ticks: { color: '#6B7894' }
                            },
                            y: {
                                grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                                ticks: { color: '#6B7894', stepSize: 1 },
                                beginAtZero: true
                            }
                        }
                    }
                });

                var statusColors = ['#63D2BE', '#F4A535', '#F05A5A', '#3A4460'];
                statusChart = new Chart(document.getElementById('statusChart'), {
                    type: 'doughnut',
                    data: {
                        labels: data.statusDistribution.labels,
                        datasets: [{
                            data: data.statusDistribution.values,
                            backgroundColor: statusColors,
                            borderWidth: 3,
                            borderColor: '#1C2540',
                            hoverBorderColor: '#1C2540'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        cutout: '65%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#161D2E',
                                borderColor: 'rgba(99,210,190,0.3)',
                                borderWidth: 1,
                                titleColor: '#63D2BE',
                                bodyColor: '#F0F4FF'
                            }
                        }
                    }
                });

                // Custom legend
                var legendHtml = '';
                data.statusDistribution.labels.forEach(function (lbl, i) {
                    legendHtml += `<div style="display:flex;align-items:center;justify-content:space-between;padding:4px 0;font-size:0.72rem;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <div style="width:8px;height:8px;border-radius:50%;background:${statusColors[i]};flex-shrink:0"></div>
                            <span style="color:var(--tm-muted)">${lbl}</span>
                        </div>
                        <span style="font-family:var(--font-mono);font-weight:500;color:${statusColors[i]}">${data.statusDistribution.values[i]}</span>
                    </div>`;
                });
                document.getElementById('statusLegend').innerHTML = legendHtml;

            }).fail(function () { console.error('Stats API failed'); });
        }

        function loadRecent() {
            $.get('/api/dashboard/recent-requests', function (data) {
                if (!data || data.length === 0) {
                    $('#recentRequests').html('<li style="padding:2.5rem;text-align:center;color:var(--tm-muted);font-family:var(--font-mono);font-size:0.75rem;">No recent requests</li>');
                    return;
                }

                var initials = function (str) {
                    return str ? str.split(' ').map(function (w) { return w[0]; }).slice(0, 2).join('').toUpperCase() : '??';
                };

                var avatarColors = [
                    { bg: 'rgba(99,210,190,0.12)', color: '#63D2BE' },
                    { bg: 'rgba(90,219,142,0.10)', color: '#5ADB8E' },
                    { bg: 'rgba(244,165,53,0.12)',  color: '#F4A535' },
                    { bg: 'rgba(240,90,90,0.10)',   color: '#F05A5A' },
                    { bg: 'rgba(107,120,148,0.12)', color: '#6B7894' }
                ];

                var html = '';
                data.forEach(function (r, i) {
                    var av = avatarColors[i % avatarColors.length];
                    var badgeClass = r.status === 'Pending' ? 'tm-badge-pending'
                        : r.status === 'Approved' ? 'tm-badge-active'
                        : r.status === 'Draft' ? 'tm-badge-draft'
                        : 'tm-badge-expired';
                    html += `<li class="tm-req-item">
                        <div class="tm-req-avatar" style="background:${av.bg};color:${av.color}">${initials(r.description)}</div>
                        <div style="flex:1;min-width:0">
                            <div class="tm-req-desc" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${r.description}</div>
                            <div class="tm-req-meta">Contract: ${r.contractName}</div>
                        </div>
                        <div style="text-align:right;flex-shrink:0">
                            <span class="tm-badge ${badgeClass}">${r.status}</span>
                            <div class="tm-req-date">${new Date(r.date).toLocaleDateString('en-ZA', {day:'2-digit',month:'short',year:'numeric'})}</div>
                        </div>
                    </li>`;
                });
                $('#recentRequests').html(html);
            }).fail(function () {
                $('#recentRequests').html('<li style="padding:2rem;text-align:center;color:var(--tm-red);font-size:0.75rem;">Error loading data</li>');
            });
        }
    </script>
}
