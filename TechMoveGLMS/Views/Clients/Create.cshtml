@model TechMoveGLMS.Models.Client

@{
    ViewData["Title"] = "New Client";
}

<div style="max-width: 560px; margin: 0 auto;">
    <div style="margin-bottom: 1.5rem;">
        <span class="tm-section-label">Clients / New</span>
        <h1 style="font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; letter-spacing: -0.04em; margin: 0;">
            Add Client
        </h1>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-user-plus me-2" style="color: var(--tm-teal);"></i>Client Profile
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: none;"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label">Client Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Acme Logistics Pty Ltd" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ContactDetails" class="form-label">Contact Details</label>
                    <input asp-for="ContactDetails" class="form-control" placeholder="email@domain.com | +27 11 000 0000" />
                    <span asp-validation-for="ContactDetails" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Region" class="form-label">Region</label>
                    <input asp-for="Region" class="form-control" placeholder="e.g. Gauteng, Western Cape" />
                    <span asp-validation-for="Region" class="text-danger"></span>
                </div>

                <hr style="border-color: var(--tm-border); margin: 1.5rem 0;" />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="tm-btn-ghost">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="tm-btn-primary">
                        <i class="fas fa-save"></i> Create Client
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
