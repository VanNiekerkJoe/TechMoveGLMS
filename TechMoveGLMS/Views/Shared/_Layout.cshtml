<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TechMove GLMS</title>

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ── TOKENS ── */
        :root {
            --tm-ink: #0A0E1A;
            --tm-surface: #0D1220;
            --tm-panel: #161D2E;
            --tm-border: rgba(255,255,255,0.07);
            --tm-border-hi: rgba(99,210,190,0.40);
            --tm-teal: #63D2BE;
            --tm-teal-light: #85E5D2;
            --tm-green: #5ADB8E;
            --tm-amber: #F4A535;
            --tm-red: #F05A5A;
            --tm-text: #F0F4FF;
            --tm-muted: #6B7894;
            --tm-subtle: #3A4460;
            --tm-display: 'Syne', sans-serif;
            --tm-mono: 'DM Mono', monospace;
            --tm-body: 'Inter', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--tm-ink);
            font-family: var(--tm-body);
            color: var(--tm-text);
            -webkit-font-smoothing: antialiased;
        }

        /* ── TICKER ── */
        .tm-ticker {
            background: rgba(0,0,0,0.3);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--tm-border);
            padding: 6px 24px;
            font-family: var(--tm-mono);
            font-size: 0.7rem;
            overflow: hidden;
            white-space: nowrap;
        }

        .ticker-track {
            display: flex;
            gap: 18px;
            align-items: center;
            flex-wrap: wrap;
        }

        .ticker-label {
            color: var(--tm-muted);
            margin-right: 6px;
        }

        .ticker-val {
            color: var(--tm-teal);
            font-weight: 500;
        }

        .ticker-chg {
            font-size: 0.65rem;
        }

            .ticker-chg.up {
                color: var(--tm-green);
            }

        .ticker-sep {
            color: var(--tm-subtle);
        }

        /* ── NAVBAR ── */
        .tm-nav {
            background: var(--tm-surface);
            border-bottom: 1px solid var(--tm-border);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .tm-nav-inner {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0.7rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .tm-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-family: var(--tm-display);
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--tm-text);
        }

        .tm-logo {
            width: 32px;
            height: 32px;
            background: var(--tm-teal);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.9rem;
            color: var(--tm-ink);
        }

        .tm-brand-sub {
            font-weight: 400;
            color: var(--tm-teal);
        }

        .tm-nav-links {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            background: rgba(255,255,255,0.02);
            padding: 4px;
            border-radius: 40px;
        }

        .tm-nav-link {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0.5rem 1rem;
            border-radius: 30px;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--tm-muted);
            transition: all 0.2s;
        }

            .tm-nav-link i {
                font-size: 0.85rem;
            }

            .tm-nav-link:hover {
                color: var(--tm-text);
                background: rgba(255,255,255,0.03);
            }

            .tm-nav-link.active {
                background: var(--tm-panel);
                color: var(--tm-teal);
            }

        .tm-nav-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tm-btn-ghost, .tm-btn-primary {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0.5rem 1rem;
            border-radius: 30px;
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 500;
            transition: all 0.2s;
        }

        .tm-btn-ghost {
            background: transparent;
            border: 1px solid var(--tm-border);
            color: var(--tm-muted);
        }

            .tm-btn-ghost:hover {
                border-color: var(--tm-teal);
                color: var(--tm-teal);
            }

        .tm-btn-primary {
            background: var(--tm-teal);
            color: var(--tm-ink);
        }

            .tm-btn-primary:hover {
                background: var(--tm-teal-light);
                transform: translateY(-1px);
            }

        /* ── USER CHIP ── */
        .tm-user-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 10px 4px 4px;
            border: 1px solid var(--tm-border);
            border-radius: 30px;
            cursor: pointer;
            transition: border-color 0.2s;
            background: var(--tm-panel);
            position: relative;
            user-select: none;
        }

            .tm-user-chip:hover {
                border-color: var(--tm-border-hi);
            }

        .tm-user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(99,210,190,0.14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--tm-display);
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--tm-teal);
        }

            .tm-user-avatar.admin-av {
                background: rgba(99,210,190,0.14);
                color: var(--tm-teal);
            }

            .tm-user-avatar.manager-av {
                background: rgba(244,165,53,0.14);
                color: var(--tm-amber);
            }

            .tm-user-avatar.user-av {
                background: rgba(90,169,240,0.12);
                color: #5AA9F0;
            }

        .tm-chip-name {
            font-size: 0.74rem;
            font-weight: 500;
            color: var(--tm-text);
        }

        .tm-chip-role {
            font-family: var(--tm-mono);
            font-size: 0.58rem;
            color: var(--tm-muted);
        }

        .tm-chip-caret {
            color: var(--tm-muted);
            font-size: 0.55rem;
            margin-left: 2px;
            transition: transform 0.2s;
        }

        .tm-user-chip.open .tm-chip-caret {
            transform: rotate(180deg);
        }

        /* ── DROPDOWN ── */
        .tm-user-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            background: var(--tm-panel);
            border: 1px solid var(--tm-border);
            border-radius: 14px;
            padding: 6px;
            min-width: 210px;
            z-index: 2000;
            display: none;
        }

        @@keyframes ddFadeIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .tm-user-dropdown.open {
            display: block;
            animation: ddFadeIn 0.15s ease;
        }

        .tm-dd-header {
            padding: 0.75rem 0.85rem 0.65rem;
            border-bottom: 1px solid var(--tm-border);
            margin-bottom: 5px;
        }

        .tm-dd-full-name {
            font-family: var(--tm-display);
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--tm-text);
            margin-bottom: 4px;
        }

        .tm-dd-username {
            font-family: var(--tm-mono);
            font-size: 0.62rem;
            color: var(--tm-muted);
            margin-bottom: 6px;
        }

        .tm-dd-role-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-family: var(--tm-mono);
            font-size: 0.6rem;
            padding: 2px 8px;
            border-radius: 5px;
        }

            .tm-dd-role-badge.admin {
                background: rgba(99,210,190,0.12);
                color: var(--tm-teal);
            }

            .tm-dd-role-badge.manager {
                background: rgba(244,165,53,0.12);
                color: var(--tm-amber);
            }

            .tm-dd-role-badge.user {
                background: rgba(90,169,240,0.10);
                color: #5AA9F0;
            }

        .tm-dd-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 9px;
            font-size: 0.78rem;
            color: var(--tm-muted);
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
        }

            .tm-dd-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--tm-text);
            }

            .tm-dd-item i {
                font-size: 13px;
                width: 16px;
                text-align: center;
            }

        .tm-dd-divider {
            height: 1px;
            background: var(--tm-border);
            margin: 5px 0;
        }

        .tm-dd-item.tm-dd-signout {
            color: var(--tm-red);
        }

            .tm-dd-item.tm-dd-signout:hover {
                background: rgba(240,90,90,0.08);
                color: var(--tm-red);
            }

        /* ── MAIN & FOOTER ── */
        .tm-main {
            min-height: calc(100vh - 140px);
            padding: 1.5rem 0;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .tm-footer {
            background: var(--tm-surface);
            border-top: 1px solid var(--tm-border);
            padding: 1.2rem 2rem;
            text-align: center;
            font-size: 0.7rem;
            color: var(--tm-muted);
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 992px) {
            .tm-nav-links, .tm-nav-actions .d-lg-flex {
                display: none;
            }

            .tm-nav-inner {
                justify-content: space-between;
            }
        }
    </style>
</head>
<body>

    <!-- TICKER -->
    <div class="tm-ticker">
        <div class="ticker-track">
            <span class="ticker-item">
                <span class="ticker-label">USD/ZAR</span>
                <span class="ticker-val" id="tickerRate">18.9412</span>
                <span class="ticker-chg up">▲ 0.12%</span>
            </span>
            <span class="ticker-sep">|</span>
            <span class="ticker-item">
                <span class="ticker-label">SYSTEM STATUS</span>
                <span class="ticker-val" style="color: var(--tm-green);">OPERATIONAL</span>
            </span>
            <span class="ticker-sep">|</span>
            <span class="ticker-item">
                <span class="ticker-label">@DateTime.Now.ToString("ddd dd MMM yyyy · HH:mm")</span>
            </span>
        </div>
    </div>

    <!-- NAVBAR -->
    <nav class="tm-nav">
        <div class="tm-nav-inner">
            <a class="tm-brand" href="@Url.Action("Index", "Home")">
                <div class="tm-logo">TM</div>
                <span>TechMove <span class="tm-brand-sub">GLMS</span></span>
            </a>

            <div class="tm-nav-links">
                <a class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Dashboard</a>
                <a class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "")"
                   href="@Url.Action("Index", "Clients")"><i class="fas fa-users"></i> Clients</a>
                <a class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contracts" ? "active" : "")"
                   href="@Url.Action("Index", "Contracts")"><i class="fas fa-file-signature"></i> Contracts</a>
                <a class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")"
                   href="@Url.Action("Index", "ServiceRequests")"><i class="fas fa-headset"></i> Requests</a>
            </div>

            <div class="tm-nav-actions">
                <a href="@Url.Action("Create", "Contracts")" class="tm-btn-ghost d-none d-lg-flex">
                    <i class="fas fa-file-signature"></i> New Contract
                </a>
                <a href="@Url.Action("Create", "ServiceRequests")" class="tm-btn-primary d-none d-lg-flex">
                    <i class="fas fa-plus"></i> New Request
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var displayName = User.Identity.Name ?? "User";
                    var initials = string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2).Select(w => w[0].ToString().ToUpper()));
                    var isAdmin = User.IsInRole("Admin");
                    var isManager = User.IsInRole("Manager");
                    var roleLabel = isAdmin ? "Admin" : isManager ? "Manager" : "User";
                    var roleClass = isAdmin ? "admin" : isManager ? "manager" : "user";
                    var avClass = isAdmin ? "admin-av" : isManager ? "manager-av" : "user-av";

                    <div class="tm-user-chip" id="userChip">
                        <div class="tm-user-avatar @avClass">@initials</div>
                        <div>
                            <div class="tm-chip-name">@displayName</div>
                            <div class="tm-chip-role">@roleLabel</div>
                        </div>
                        <span class="tm-chip-caret">▾</span>

                        <div class="tm-user-dropdown" id="userDropdown">
                            <div class="tm-dd-header">
                                <div class="tm-dd-full-name">@displayName</div>
                                <div class="tm-dd-username">@@@User.Identity.Name</div>
                                <span class="tm-dd-role-badge @roleClass">
                                    <i class="fas fa-@(isAdmin ? "shield-alt" : isManager ? "briefcase" : "user")"></i>
                                    @roleLabel
                                </span>
                            </div>
                            <a href="#" class="tm-dd-item"><i class="fas fa-user-circle"></i> My Profile</a>
                            <a href="#" class="tm-dd-item"><i class="fas fa-cog"></i> Settings</a>
                            <div class="tm-dd-divider"></div>
                            <a href="@Url.Action("Logout", "Auth")" class="tm-dd-item tm-dd-signout">
                                <i class="fas fa-sign-out-alt"></i> Sign out
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Auth")" class="tm-btn-ghost">
                        <i class="fas fa-sign-in-alt"></i> Sign in
                    </a>
                }
            </div>

            <button class="navbar-toggler d-lg-none ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                    style="background: transparent; border: 1px solid var(--tm-border); padding: 6px 10px; border-radius: 8px;">
                <i class="fas fa-bars" style="color: var(--tm-muted);"></i>
            </button>
        </div>

        <div class="collapse d-lg-none" id="mobileNav">
            <div style="padding: 1rem 1.5rem; border-top: 1px solid var(--tm-border);">
                <a class="tm-nav-link" href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Dashboard</a>
                <a class="tm-nav-link" href="@Url.Action("Index", "Clients")"><i class="fas fa-users"></i> Clients</a>
                <a class="tm-nav-link" href="@Url.Action("Index", "Contracts")"><i class="fas fa-file-signature"></i> Contracts</a>
                <a class="tm-nav-link" href="@Url.Action("Index", "ServiceRequests")"><i class="fas fa-headset"></i> Requests</a>
                <hr style="border-color: var(--tm-border); margin: 0.75rem 0;" />
                <a class="tm-nav-link" href="@Url.Action("Create", "Contracts")"><i class="fas fa-file-signature"></i> New Contract</a>
                <a class="tm-nav-link" href="@Url.Action("Create", "ServiceRequests")"><i class="fas fa-plus"></i> New Request</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="tm-nav-link" style="color: var(--tm-red);" href="@Url.Action("Logout", "Auth")">
                        <i class="fas fa-sign-out-alt"></i> Sign out
                    </a>
                }
            </div>
        </div>
    </nav>

    <main class="tm-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="tm-footer">
        <span>© @DateTime.Now.Year TechMove Global Logistics Management System</span>
        <span class="tm-footer-sep">·</span>
        <span style="color: var(--tm-teal);">All systems operational</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Ticker live rate
        (function() {
            var base = 18.9412;
            var el = document.getElementById('tickerRate');
            if (!el) return;
            setInterval(function() {
                base += (Math.random() - 0.5) * 0.03;
                el.textContent = base.toFixed(4);
            }, 4000);
        })();

        // User chip dropdown
        (function() {
            var chip = document.getElementById('userChip');
            var dd = document.getElementById('userDropdown');
            if (!chip || !dd) return;

            chip.addEventListener('click', function(e) {
                e.stopPropagation();
                var isOpen = dd.classList.contains('open');
                dd.classList.toggle('open', !isOpen);
                chip.classList.toggle('open', !isOpen);
            });

            document.addEventListener('click', function(e) {
                if (!chip.contains(e.target)) {
                    dd.classList.remove('open');
                    chip.classList.remove('open');
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>